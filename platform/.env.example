# YZI OS Platform — environment template
# Copie para .env.local (nunca commitar .env.local).
# Nenhuma variável é obrigatória nesta fase de scaffold.

# Ambiente da aplicação (development | production)
NODE_ENV=development

# URL base local da plataforma
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Lane 2 — Supabase Client Foundation).
# Valores públicos por design (URL + anon/publishable key), mas reais
# SOMENTE em .env.local. Service role key NUNCA entra em platform/.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Meta OAuth Start (server-side only; never prefix with NEXT_PUBLIC_).
# Valores reais SOMENTE em .env.local e no painel da Meta.
META_APP_ID=
META_LOGIN_REDIRECT_URI=
META_GRAPH_API_VERSION=
META_LOGIN_CONFIG_ID=

# Postgres (Supabase managed) — per yzi-os-postgres-provisioning-spec-v1.
# Valores reais SOMENTE em .env.local (nunca commitado). Placeholders apenas.
# Connection string com pooler (uso da aplicação)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Conexão direta (uso futuro de migrations; não autorizado nesta fase)
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
