{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-service-role.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/warn-mcp-unauthorized.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/warn-out-of-path.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/warn-long-doc.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/require-lint-build-before-commit.sh"
          }
        ]
      }
    ]
  }
}
